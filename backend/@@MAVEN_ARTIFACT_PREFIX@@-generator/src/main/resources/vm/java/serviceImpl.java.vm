        ${pkColumn.javaType} ${pkColumn.javaField} = ${className}.get${pkColumn.capJavaField}();
        ${className}Mapper.delete${column.idsFieldCap}By${pkColumn.capJavaField}(${pkColumn.javaField});
        Long[] refIds = ${className}.get${column.idsFieldCap}();
        if (refIds != null && refIds.length > 0)
