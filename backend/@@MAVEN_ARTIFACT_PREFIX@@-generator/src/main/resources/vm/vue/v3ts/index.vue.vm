<template>
  <div class="app-container">
    <el-form :model="queryParams" ref="queryRef" :inline="true" v-show="showSearch" label-width="auto">
#set($hasCollapsedQuery = false)#foreach($column in $columns)#if($column.query && !$column.common)#set($hasCollapsedQuery = true)#end#end
#set($hasRichText = false)#foreach($column in $columns)#if($column.list && $column.htmlType == "editor")#set($hasRichText = true)#end#end
#set($hasTreeSelect = false)#set($hasCascader = false)#foreach($column in $columns)#if($column.htmlType == "treeselect" && $column.refDisplay)#set($hasTreeSelect = true)#end#if($column.htmlType == "cascader")#set($hasCascader = true)#end#end
#foreach($column in $columns)
#if($column.query)
#set($dictType=$column.dictType)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
#if($column.htmlType == "input")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-input
          v-model="queryParams.${column.javaField}"
          placeholder="请输入${comment}"
          clearable
          @keyup.enter="handleQuery"
        />
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && "" != $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-select v-model="queryParams.${column.javaField}"#if($column.ruleMultiple) multiple#end placeholder="请选择${comment}" filterable clearable>
          <el-option
            v-for="dict in ${dictType}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
## 选项来自「写死代码」或「接口」——声明在 script 里，见文件末尾的 ${field}Options。
## （这里原本是 `&& $dictType` 的分支，但它在 dictType 为空串时为假、上一分支已抢先命中，
##   是不可达的死代码，所以直接改用。）
## 注意：查询区**不做 parseInt**，与上面那个字典分支保持一致。
## 多值列在查询区也是**多选**，值以数组发出去（?tags=1&tags=2 这种重复参数），
## 后端合成逗号串后由 Mapper 拆开逐个 find_in_set 用 or 连 —— 语义是「**包含任一值**」。
## 原本这儿没有分支，会落到 #else 兜底退化成文本框、且 Mapper 用 = 等值匹配 —— 逗号串永远等不中。
#elseif($column.htmlType == "checkbox" && "" != $dictType)
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-select v-model="queryParams.${column.javaField}" multiple filterable placeholder="请选择${comment}" clearable>
          <el-option
            v-for="dict in ${dictType}"
            :key="dict.value"
            :label="dict.label"
            :value="dict.value"
          />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "checkbox" && ($column.ruleOptionsJs || $column.ruleOptionsApi))
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-select v-model="queryParams.${column.javaField}" multiple filterable placeholder="请选择${comment}" clearable>
          <el-option v-for="opt in ${column.javaField}Options" :key="opt.value" :label="opt.label" :value="opt.value" />
        </el-select>
      </el-form-item>
#elseif(($column.htmlType == "select" || $column.htmlType == "radio") && ($column.ruleOptionsJs || $column.ruleOptionsApi))
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-select v-model="queryParams.${column.javaField}"#if($column.ruleMultiple) multiple#end placeholder="请选择${comment}" filterable clearable>
          <el-option
            v-for="opt in ${column.javaField}Options"
            :key="opt.value"
            :label="opt.label"
            :value="opt.value"
          />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "datetime" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="datetime"
          value-format="YYYY-MM-DD HH:mm:ss"
          placeholder="请选择${comment}">
        </el-date-picker>
      </el-form-item>
#elseif($column.htmlType == "date" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="date"
          value-format="YYYY-MM-DD"
          placeholder="请选择${comment}">
        </el-date-picker>
      </el-form-item>
#elseif($column.htmlType == "time" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-time-picker clearable
          v-model="queryParams.${column.javaField}"
          value-format="HH:mm:ss"
          placeholder="请选择${comment}">
        </el-time-picker>
      </el-form-item>
#elseif(($column.htmlType == "datetime" || $column.htmlType == "date" || $column.htmlType == "time" || $column.htmlType == "month") && $column.queryType == "BETWEEN")
      <el-form-item label="${comment}" style="width: 308px"#if(!$column.common) v-show="expandQuery"#end>
#if($column.htmlType == "time")
## 时间区间用 el-time-picker 的 is-range（绑的同样是 daterange 那份两元数组）
        <el-time-picker
          v-model="daterange${AttrName}"
          is-range
          value-format="HH:mm:ss"
          range-separator="-"
          start-placeholder="开始时间"
          end-placeholder="结束时间"
        />
#elseif($column.htmlType == "month")
        <el-date-picker
          v-model="daterange${AttrName}"
          type="monthrange"
          value-format="YYYY-MM"
          range-separator="-"
          start-placeholder="开始月份"
          end-placeholder="结束月份"
        ></el-date-picker>
#else
        <el-date-picker
          v-model="daterange${AttrName}"
          value-format="YYYY-MM-DD"
          type="daterange"
          range-separator="-"
          start-placeholder="开始日期"
          end-placeholder="结束日期"
        ></el-date-picker>
#end
      </el-form-item>
#elseif($column.htmlType == "month" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="month"
          value-format="YYYY-MM"
          placeholder="选择${comment}">
        </el-date-picker>
      </el-form-item>
#elseif($column.htmlType == "year" && $column.queryType != "BETWEEN")
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-date-picker clearable
          v-model="queryParams.${column.javaField}"
          type="year"
          value-format="YYYY"
          placeholder="选择${comment}">
        </el-date-picker>
      </el-form-item>
#elseif($column.htmlType == "switch")
## 查询区的开关用「是/否」下拉，**不用 el-switch**。
## el-switch 只有两个状态、**表达不了「不筛」**：它的值一旦不是 active 也不是 inactive
## （比如初值 undefined），EP 就会自作主张写回 inactive 值，**并且 emit change** ——
## 于是用户没碰过筛选，列表就已经被永久加上「等于否」，还不报错。
## （这个坑是真跑一次生成 + 打开列表才发现的，见模板增强清单.md。）
## 下拉有真正的空状态：clearable 清空即不筛。值发 '1'/'0'，两种存储都对得上 ——
## char(1) 直接比 '1'/'0'；tinyint(1) 的字段是 Integer，Spring 把 "1" 绑成 1 也能比。
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-select v-model="queryParams.${column.javaField}" placeholder="请选择${comment}" filterable clearable>
          <el-option label="是" value="1" />
          <el-option label="否" value="0" />
        </el-select>
      </el-form-item>
#elseif($column.htmlType == "treeselect")
## 关联字段用**表格选择器**：弹窗里搜索 + 表格，能看到多列（列由规则的 pickerColumns 指定）。
## 以前这里没有分支 → 落到兜底文本框 → 拿文本去比一个 bigint 关联 id，实际是坏的。
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <table-select
          v-model="queryParams.${column.javaField}"
          api="${column.ruleTreeApi}"
          value-field="${column.ruleTreeValueField}"
          label-field="${column.ruleTreeLabelField}"
          parent-field="${column.ruleTreeParentField}"#if($column.ruleMultiple)
          multiple#end
#if($column.rulePickerColumnList.size() > 0)
          :columns="[#foreach($pc in $column.rulePickerColumnList){ label: '$pc.label', prop: '$pc.prop'#if("$!pc.dictType" != ""), dictType: '$pc.dictType'#end }#if($foreach.count != $column.rulePickerColumnList.size()), #end#end]"
#end
          placeholder="请选择${comment}"
          title="选择${comment}"
        />
      </el-form-item>
#else
      <!-- ⚠️ 兜底分支，不要删。理由同表单区：没配上就静默丢一个查询条件 -->
      <el-form-item label="${comment}" prop="${column.javaField}"#if(!$column.common) v-show="expandQuery"#end>
        <el-input
          v-model="queryParams.${column.javaField}"
          placeholder="请输入${comment}"
          clearable
          @keyup.enter="handleQuery"
        />
      </el-form-item>
#end
#end
#end
      <el-form-item>
        <el-button type="primary" icon="Search" @click="handleQuery">搜索</el-button>
        <el-button icon="Refresh" @click="resetQuery">重置</el-button>
#if($hasCollapsedQuery)
        <el-button link type="primary" :icon="expandQuery ? 'ArrowUp' : 'ArrowDown'" @click="toggleExpandQuery">{{ expandQuery ? '收起' : '展开查看更多' }}</el-button>
#end
      </el-form-item>
    </el-form>

    <el-row :gutter="10" class="mb8">
      <el-col :span="1.5">
        <el-button
          type="primary"
          plain
          icon="Plus"
          @click="handleAdd"
          v-hasPermi="['${permissionPrefix}:add']"
        >新增</el-button>
      </el-col>
#if(!$table.tree)
## 树表没有多选列，这两个批量按钮永远点不了 —— 不生成。
## 树表的改/删在**行内操作列**里，每行一个。
      <el-col :span="1.5">
        <el-button
          type="success"
          plain
          icon="Edit"
          :disabled="single"
          @click="handleUpdate"
          v-hasPermi="['${permissionPrefix}:edit']"
        >修改</el-button>
      </el-col>
      <el-col :span="1.5">
        <el-button
          type="danger"
          plain
          icon="Delete"
          :disabled="multiple"
          @click="handleDelete"
          v-hasPermi="['${permissionPrefix}:remove']"
        >删除</el-button>
      </el-col>
#end
      <el-col :span="1.5">
        <el-button
#if($table.tree)
## 树表用「展开/折叠」代替「导出」—— 列表不分页，展平导出意义不大
          type="info"
          plain
          icon="Sort"
          @click="toggleExpandAll"
        >展开/折叠</el-button>
#else
          type="warning"
          plain
          icon="Download"
          @click="handleExport"
          v-hasPermi="['${permissionPrefix}:export']"
        >导出</el-button>
#end
      </el-col>
      <right-toolbar v-model:showSearch="showSearch" @queryTable="getList"></right-toolbar>
    </el-row>

    <el-table
#if($table.tree)
      v-if="refreshTable"
      :data="${businessName}List"
      row-key="${treeCode}"
      :default-expand-all="isExpandAll"
      :tree-props="{children: 'children', hasChildren: 'hasChildren'}"
#else
      v-loading="loading"
      :data="${businessName}List"
#end
      @selection-change="handleSelectionChange"
    >
#if(!$table.tree)
## 树表**不能**有多选列：el-table 的树形缩进固定作用在第一列，
## 多选列占第一列会把缩进挂到复选框上。若依原生树页（system/dept）同样没有。
      <el-table-column type="selection" width="55" align="center" />
#end
#foreach($column in $columns)
#set($javaField=$column.javaField)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
## 表头最小宽度：按标签字数估算。
## 不给宽度的列会被 el-table 均分（列多时每列仅 80px），长标签就会折成两行 ——
## 而 el-table 的表头行取**所有列的最大高度**，只要有一列换行，整行都变高。
#set($colMinWidth = $comment.length() * 14 + 40)
#if($colMinWidth < 100)#set($colMinWidth = 100)#end
## 多值列（checkbox / 多选）在列表里要并排显示多个标签，按标签字数估的 100px 放不下两个
## （两个两字标签约 96px，加上单元格 padding 就溢出换行了）—— 放宽到能并排两个标签。
#if($column.multiValue)#set($colMinWidth = 150)#end
#if($column.refDisplay && $refDisplayTargets.containsKey($column.ruleDisplayColumn))
## 配了冗余显示列，且那一列真的存在 —— 列表交给那一列（名称），别把裸 id 也并排显示出来
#elseif($column.pk)
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}" />
#elseif($column.list && $column.htmlType == "datetime")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{y}-{m}-{d} {h}:{i}:{s}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "date")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{y}-{m}-{d}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "time")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{h}:{i}:{s}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "imageUpload")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="100">
        <template #default="scope">
## imagePreview 内部是 props.src.split(",")，只认逗号串 —— 而多值列出参已经是数组，这里要拼回去
          <image-preview :src="(scope.row.${javaField} || []).join(',')" :width="50" :height="50"/>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "fileUpload")
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
## 附件列：一个「查看」按钮弹窗列出所有附件，每个附件给下载按钮（见 FileList 组件）
          <file-list :value="scope.row.${javaField}" label="${comment}"/>
        </template>
      </el-table-column>
#elseif($column.list && "" != $column.dictType)
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
## DictTag 本来就同时吃数组与逗号串（内部 Array.isArray 分叉），所以多值列不用再单独 split
          <dict-tag :options="${column.dictType}" :value="scope.row.${javaField}"/>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "cascader")
## 用**扁平**那份选项做一层查找 —— 存的是叶子值，正好够
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
          <dict-tag :options="${javaField}Flat" :value="scope.row.${javaField}"/>
        </template>
      </el-table-column>
#elseif($column.list && ($column.ruleOptionsJs || $column.ruleOptionsApi) && !$column.junction)
## 选项来自「写死代码」或「接口」。仍然用 dict-tag —— 它的 options 接受任意 {label,value} 数组，
## 所以三种来源（字典 / 写死 / 接口）在这一处**共用同一个组件**，不用改 DictTag。
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
          <dict-tag :options="${javaField}Options" :value="scope.row.${javaField}"/>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "month")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{y}-{m}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "year")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <span>{{ parseTime(scope.row.${javaField}, '{y}') }}</span>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "switch")
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
          <el-tag :type="scope.row.${javaField} === true ? 'success' : 'info'">{{ scope.row.${javaField} === true ? '是' : '否' }}</el-tag>
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "rate")
      <el-table-column label="${comment}" align="center" prop="${javaField}" width="180">
        <template #default="scope">
          <!-- 用 :model-value 而不是 v-model —— 列表里不该改行数据 -->
          <el-rate :model-value="scope.row.${javaField}" disabled />
        </template>
      </el-table-column>
#elseif($column.list && $column.htmlType == "editor")
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
          <el-button v-if="scope.row.${javaField}" link type="primary" @click="handleViewRichText('${comment}', scope.row.${javaField})">查看</el-button>
          <span v-else>-</span>
        </template>
      </el-table-column>
#elseif($column.list && ($column.htmlType == "input" || $column.htmlType == "textarea"))
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}">
        <template #default="scope">
          <el-tooltip v-if="scope.row.${javaField}" placement="top" :show-after="300">
            <template #content>
              <div style="max-width: 420px; white-space: pre-wrap; word-break: break-all;">{{ scope.row.${javaField} }}</div>
            </template>
            <div class="cell-clamp2">{{ scope.row.${javaField} }}</div>
          </el-tooltip>
          <span v-else>-</span>
        </template>
      </el-table-column>
#elseif($column.list && "" != $javaField)
#if($table.tree && ${foreach.index} == 1)
## 树表第一个列表列是树名列，必须**朴素渲染** —— 树形缩进依赖它的样式。
## 所以树名列必须排在 gen_table_column.sort 的第一位（见 docs/生成器/模板增强清单.md）。
      <el-table-column label="${comment}" prop="${javaField}" min-width="${colMinWidth}" />
#else
      <el-table-column label="${comment}" align="center" prop="${javaField}" min-width="${colMinWidth}" />
#end
#end
#end
## 操作列固定在右侧。配合上面的 min-width（列多时会横向滚动），
## 否则一往右滚，「修改/删除」就滑出视野了 —— 而它正是最常用的操作。
## 宽度按按钮个数算：两个按钮约 140px，开了「生成详情页」多一个「详情」约 190px。
#set($opWidth = 140)
#if($genView)#set($opWidth = 190)#end
      <el-table-column label="操作" align="center" class-name="small-padding fixed-width" fixed="right" width="${opWidth}">
        <template #default="scope">
#if($genView)
          <el-button link type="primary" icon="View" @click="handleViewData(scope.row)" v-hasPermi="['${permissionPrefix}:query']">详情</el-button>
#end
          <el-button link type="primary" icon="Edit" @click="handleUpdate(scope.row)" v-hasPermi="['${permissionPrefix}:edit']">修改</el-button>
#if($table.tree)
          <el-button link type="primary" icon="Plus" @click="handleAdd(scope.row)" v-hasPermi="['${permissionPrefix}:add']">新增</el-button>
#end
          <el-button link type="primary" icon="Delete" @click="handleDelete(scope.row)" v-hasPermi="['${permissionPrefix}:remove']">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
    
#if(!$table.tree)
## 树表不分页 —— 后端一次返回全量，前端用 proxy.handleTree 拼树
    <pagination
      v-show="total>0"
      :total="total"
      v-model:page="queryParams.pageNum"
      v-model:limit="queryParams.pageSize"
      @pagination="getList"
    />
#end

#if($genView)
    <!-- ${functionName}详情抽屉 -->
    <${businessName}-view-drawer ref="${businessName}ViewRef" />
#end
    <!-- 添加或修改${functionName}对话框 -->
#if($table.formColNum == 2)
#set($dialogWidth = "800px")
#elseif($table.formColNum == 3)
#set($dialogWidth = "1100px")
#else
#set($dialogWidth = "500px")
#end
    <el-dialog :title="title" v-model="open" width="${dialogWidth}" append-to-body>
      <el-form ref="${businessName}Ref" :model="form" :rules="rules" label-width="auto">
        <el-row>
#foreach($column in $columns)
#set($field=$column.javaField)
#if(($column.insert && !$column.pk) || $column.junction)
