const ${businessName}List = ref<${ClassName}[]>([])
#if($table.tree)
/** 父节点下拉的选项（含一个虚拟顶级节点） */
const ${businessName}Options = ref<TreeSelect[]>([])
#end
#if($table.sub)
const ${subclassName}List = ref<${subClassName}[]>([])
#end
const open = ref<boolean>(false)
const loading = ref<boolean>(true)
const showSearch = ref<boolean>(true)
#if($hasRichText)
/** 查看富文本内容。
 *  用 v-html 渲染，依赖后端 HTMLFilter 在入库时已过滤（默认开启，见 @@MAVEN_ARTIFACT_PREFIX@@-common 的 HTMLFilter）。 */
const richTextDialog = reactive({ visible: false, title: '', html: '' })
function handleViewRichText(title: string, html: string) {
  richTextDialog.title = title
  richTextDialog.html = html || ''
  richTextDialog.visible = true
}
#end
#if($hasCollapsedQuery)
// 「展开查看更多」开关。控制非常用查询条件的显隐（模板里用 v-show 挂在 el-form-item 上，
// 而不是 v-if —— 这样 resetQuery 的 resetForm 仍能收集到被折叠的字段，
// 否则会出现「看不见但仍在生效」的筛选条件）
const expandQuery = ref<boolean>(false)
#end
const ids = ref<number[]>([])
#if($table.sub)
const checked${subClassName} = ref<number[]>([])
#end
const single = ref<boolean>(true)
const multiple = ref<boolean>(true)
const total = ref<number>(0)
const title = ref<string>("")
#if($table.tree)
const isExpandAll = ref<boolean>(true)
## 展开/折叠要靠**重建表格**才生效 —— default-expand-all 是初始化属性，改它不会重渲染
const refreshTable = ref<boolean>(true)
#end
#foreach ($column in $columns)
#if(($column.htmlType == "datetime" || $column.htmlType == "date" || $column.htmlType == "time" || $column.htmlType == "month") && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
const daterange${AttrName} = ref<string[]>([])
#end
#end

const data = reactive({
  form: {} as ${ClassName},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    #foreach ($column in $columns)
#if($column.query)
#if($column.multiSelectQuery)
## 查询区出多选（有选项来源的多值列）→ 初值是数组；tansParams 对空数组不发任何参数，等于没筛
    $column.javaField: []#if($foreach.count != $columns.size()),#end
#else
    $column.javaField: undefined#if($foreach.count != $columns.size()),#end
#end
#end
#end
  } as ${BusinessName}QueryParams,
  rules: {
    #foreach ($column in $columns)
#if($column.required || $column.rulePattern)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
    $column.javaField: [
#if($column.required)
      { required: true, message: "$comment不能为空", trigger: #if($column.htmlType == "select" || $column.htmlType == "radio" || $column.htmlType == "treeselect" || $column.htmlType == "checkbox")"change"#else"blur"#end }#if($column.rulePattern),#end
#end
#if($column.rulePattern)
      { pattern: new RegExp($column.rulePatternJs), message: $column.rulePatternMessageJs, trigger: "blur" }
#end
    ]#if($foreach.count != $columns.size()),#end
#end
#end
  }
})

const { queryParams, form, rules } = toRefs(data)

#if($hasCollapsedQuery)
/** 展开/收起非常用查询条件 */
function toggleExpandQuery() {
  expandQuery.value = !expandQuery.value
  // 右侧 RightToolbar 的放大镜在收起/展开整个搜索区时，会在 el-form 上留下内联的
  // max-height 且不保证清理掉（它的 setTimeout 调度在双层 requestAnimationFrame 之外，
  // 存在竞态）。而本页的「展开查看更多」会改变表单高度，一旦那个过期的 max-height 还在，
  // 新增的那一行就会被截断、点了没反应。这里主动清一次，代价可忽略。
  nextTick(() => {
    // 取 el-form 的根元素。**必须走 proxy.$refs** —— 模板里 ref="queryRef" 并不会
    // 在 <script setup> 里自动生成一个 queryRef 变量（除非显式 const queryRef = ref()），
    // 直接写 queryRef.value 会抛 ReferenceError。上游各页面统一用 proxy.$refs["xxx"]。
    const form = (proxy?.$refs["queryRef"] as { $el?: HTMLElement } | undefined)?.$el
    if (form && form.style.maxHeight) {
      form.style.maxHeight = ''
      form.style.overflow = ''
      form.style.transition = ''
      form.style.opacity = ''
    }
  })
}
#end

/** 查询${functionName}列表 */
function getList() {
  loading.value = true
#foreach ($column in $columns)
#if(($column.htmlType == "datetime" || $column.htmlType == "date" || $column.htmlType == "time" || $column.htmlType == "month") && $column.queryType == "BETWEEN")
  queryParams.value.params = {}
#break
#end
#end
#foreach ($column in $columns)
#if(($column.htmlType == "datetime" || $column.htmlType == "date" || $column.htmlType == "time" || $column.htmlType == "month") && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  if (daterange${AttrName}.value.length > 0) {
    queryParams.value.params["begin${AttrName}"] = daterange${AttrName}.value[0]
    queryParams.value.params["end${AttrName}"] = daterange${AttrName}.value[1]
  }
#end
#end
  list${BusinessName}(queryParams.value).then(response => {
#if($table.tree)
## 树表后端返回 AjaxResult：全量数组在 `data` 里，**没有 rows/total** —— 所以这里不能走单表那套。
## 少了这个分支的产物会 `= undefined`，表格整片空白（且不报错）。
    ${businessName}List.value = proxy.handleTree(response.data, "${treeCode}", "${treeParentCode}")
#else
    ${businessName}List.value = response.rows
    total.value = response.total
#end
    loading.value = false
  })
}

/** 取消按钮 */
function cancel() {
  open.value = false
  reset()
}

/** 清空按钮操作：不关弹窗，只把字段（含子表）恢复成初始状态。
 *  **文本字段写空串而不是 null** —— RuoYi 的 update 是「只写非 null 字段」的部分更新，
 *  留在 null 的话点确定时老值会**静默保留**（界面上看着清了、库里没清）。
 *  数字/日期类没法这么办（只吃 null，而 null 会被跳过），仍是保留原值。
 *  **保留主键** —— 编辑态下清空是「把这条记录抹掉重填」，清完点确定仍更新这条，
 *  而不是静默变成新增（标题还写着「修改」却插了一条，那太意外了）。 */
function clearForm() {
  proxy.#[[$modal]]#.confirm('确认清空已填内容？').then(() => {
    const _${pkColumn.javaField} = form.value.${pkColumn.javaField}
    reset()
    form.value.${pkColumn.javaField} = _${pkColumn.javaField}
## 与弹窗表单的字段循环**用同一个判据**，保证只碰「表单里真实存在的字段」。
## 换成遍历 $columns 就会把 del_flag / create_by 这些没渲染、is_insert=0 的列也写成空串 ——
## del_flag 变空串后记录会直接从列表里消失。
#foreach($column in $columns)
#if($column.insert && !$column.pk)
#if(($column.usableColumn) || (!$column.superColumn))
#if($column.javaType == "String" && !$column.multiValue && $column.htmlType != "switch")
    form.value.$column.javaField = ''
#end
#end
#end
#end
  }).catch(() => {})
}

/** 表单重置 */
function reset() {
  form.value = {
#foreach ($column in $columns)
#if($column.junction)
## 多对多的 id 集合存在辅助表里（瞬时字段），初值给空数组
    $column.ruleIdsField: []#if($foreach.count != $columns.size()),#end
#elseif($column.multiValue)
## 多值字段（含图片/附件）：控件的 v-model 要数组，后端出参也是数组（见 @MultiValue）
    $column.javaField: []#if($foreach.count != $columns.size()),#end
#elseif($column.htmlType == "switch")
## 开关用布尔：@FlagValue 负责与库里 char(1) 的 '1'/'0' 互转
    $column.javaField: false#if($foreach.count != $columns.size()),#end
#else
    $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
  }
#if($table.sub)
  ${subclassName}List.value = []
#end
  proxy.resetForm("${businessName}Ref")
}

/** 搜索按钮操作 */
function handleQuery() {
  queryParams.value.pageNum = 1
  getList()
}

/** 重置按钮操作 */
function resetQuery() {
#foreach ($column in $columns)
#if(($column.htmlType == "datetime" || $column.htmlType == "date" || $column.htmlType == "time" || $column.htmlType == "month") && $column.queryType == "BETWEEN")
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
  daterange${AttrName}.value = []
#end
#end
  proxy.resetForm("queryRef")
  handleQuery()
}

/** 多选框选中数据 */
function handleSelectionChange(selection: ${ClassName}[]) {
  ids.value = selection.map(item => item.${pkColumn.javaField})
  single.value = selection.length != 1
  multiple.value = !selection.length
}

#if($hasCascader)
#foreach($column in $columns)
#if($column.htmlType == "cascader")
/** 「${column.columnComment}」的级联选项 —— 拉**扁平**列表，一份建树、一份拍平 */
const ${column.javaField}Options = ref<any[]>([])
const ${column.javaField}Tree = computed(() => proxy.handleTree(${column.javaField}Options.value, "${column.ruleTreeValueField}", "${column.ruleTreeParentField}") || [])
const ${column.javaField}Flat = computed(() => ${column.javaField}Options.value.map((it: any) => ({ label: it["${column.ruleTreeLabelField}"], value: String(it["${column.ruleTreeValueField}"]) })))
request({ url: "${column.ruleTreeApi}", method: "get" }).then((res: any) => {
  ${column.javaField}Options.value = (res && (res.data || res.rows)) || []
})
#end
#end
#end
#if($hasTreeSelect)
#foreach($column in $columns)
#if($column.htmlType == "treeselect")
#if($column.refDisplay)
## 查询区与表单区的控件是**表格选择器**（组件自己拉数据），所以这份选项只剩一个用途：
## 提交时把选中的 id 反查成名称写进显示列 —— 所以只要一份扁平列表，不用建树。
## （形状照 cascader 的 Flat：{label,value}，直接喂 selectDictLabel）
const ${column.javaField}Raw = ref<any[]>([])
const ${column.javaField}Flat = computed(() => ${column.javaField}Raw.value.map((it: any) => ({ label: it["${column.ruleRefLabelField}"], value: String(it["${column.ruleRefValueField}"]) })))
function load${column.attrName}Options() {
  request({ url: "${column.ruleTreeApi}", method: "get" }).then((res: any) => {
    ${column.javaField}Raw.value = (res && (res.data || res.rows)) || []
  })
}
#end
#end
#end
#end

/** 新增按钮操作 */
#if($table.tree)
/** 拉全量后拼树，并塞一个「顶级节点」虚拟根（${treeCode} 为 0） */
function getTreeselect() {
  list${BusinessName}().then(response => {
    ${businessName}Options.value = []
    const data = { ${treeCode}: 0, ${treeName}: '顶级节点', children: [] }
    data.children = proxy.handleTree(response.data, "${treeCode}", "${treeParentCode}")
    ${businessName}Options.value.push(data)
  })
}

/** 展开/折叠 */
function toggleExpandAll() {
  refreshTable.value = false
  isExpandAll.value = !isExpandAll.value
  nextTick(() => {
    refreshTable.value = true
  })
}

/** 树表的新增带 row —— 从某一行的「新增」点进来时预置父节点 */
function handleAdd(row: ${ClassName}) {
  reset()
#if($hasTreeSelect)
#foreach($column in $columns)
#if($column.htmlType == "treeselect")
  load${column.attrName}Options()
#end
#end
#end
  getTreeselect()
  if (row != null && row.${treeCode}) {
    form.value.${treeParentCode} = row.${treeCode}
  } else {
    form.value.${treeParentCode} = 0
  }
  open.value = true
  title.value = "添加${functionName}"
}
#else
function handleAdd() {
  reset()
#if($hasTreeSelect)
#foreach($column in $columns)
#if($column.htmlType == "treeselect")
  load${column.attrName}Options()
#end
#end
#end
  open.value = true
  title.value = "添加${functionName}"
}
#end

/** 修改按钮操作 */
function handleUpdate(row: ${ClassName}) {
  reset()
#if($hasTreeSelect)
#foreach($column in $columns)
#if($column.htmlType == "treeselect")
  load${column.attrName}Options()
#end
#end
#end
#if($table.tree)
## 直接点「修改」（没先点过「新增」）时，父节点下拉的选项还没拉过 —— 不补这一行会是空下拉
  getTreeselect()
#end
  const _${pkColumn.javaField} = row.${pkColumn.javaField} || ids.value[0]
  get${BusinessName}(_${pkColumn.javaField}).then(response => {
    form.value = response.data!
## 多值字段这里**什么都不用做**：@MultiValue 的出参就是数组。
## （旧模板在这一层 split(",") 且没有 null 兜底 —— 后端是 null 时直接 TypeError。）
#if($table.sub)
    ${subclassName}List.value = response.data?.${subclassName}List ?? []
#end
    open.value = true
    title.value = "修改${functionName}"
  })
}

/** 提交按钮 */
function submitForm() {
  proxy.#[[$]]#refs["${businessName}Ref"].validate((valid: boolean) => {
    if (valid) {
## 多值字段直接发数组、开关直接发布尔，后端 @MultiValue / @FlagValue 负责转成存储形状。
## 这里原本有一层 join(",")，去掉它才是「线格式按语义给」。
#foreach($column in $columns)
#if($column.junction)
## 多对多：名称最终由后端按辅助表重算（refresh 语句），这份只为提交后的即时状态
      form.value.${column.ruleDisplayColumn} = (form.value.${column.ruleIdsField} || []).map((v: any) => proxy.selectDictLabel(${column.javaField}Options.value, v)).join(',')
#end
#if($column.refDisplay && ($column.htmlType == "treeselect" || $column.ruleOptionsJs || $column.ruleOptionsApi))
## 冗余显示列：把选中的 id 反查成名称写进去。
## 后端保存时会用 SQL 再算一遍（那条是权威），这里写一遍是为了**提交后的即时状态也对** ——
## 此时页面上的选项早就加载好了（treeselect 在打开弹窗时就拉，接口来源的在页面加载时拉）。
#if($column.htmlType == "treeselect")
#set($refOptionRef = "${column.javaField}Flat.value")
#elseif($column.ruleOptionsApi)
#set($refOptionRef = "${column.javaField}Options.value")
#else
## ⚠️ 写死的 options 生成的是**普通数组**（不是 ref），带 `.value` 会取到 undefined
#set($refOptionRef = "${column.javaField}Options")
#end
#if($column.multiValue)
      form.value.${column.ruleDisplayColumn} = (form.value.${column.javaField} || []).map((v: any) => proxy.selectDictLabel($refOptionRef, v)).join(',')
#else
      form.value.${column.ruleDisplayColumn} = proxy.selectDictLabel($refOptionRef, form.value.${column.javaField}) || ''
#end
#end
#end
#if($table.sub)
      form.value.${subclassName}List = ${subclassName}List.value
#end
      if (form.value.${pkColumn.javaField} != null) {
        update${BusinessName}(form.value).then(() => {
          proxy.#[[$modal]]#.msgSuccess("修改成功")
          open.value = false
          getList()
        })
      } else {
        add${BusinessName}(form.value).then(() => {
          proxy.#[[$modal]]#.msgSuccess("新增成功")
          open.value = false
          getList()
        })
      }
    }
  })
}

/** 删除按钮操作 */
function handleDelete(row: ${ClassName}) {
  const _${pkColumn.javaField}s = row.${pkColumn.javaField} || ids.value
  proxy.#[[$modal]]#.confirm('是否确认删除${functionName}编号为"' + _${pkColumn.javaField}s + '"的数据项？').then(function() {
    return del${BusinessName}(_${pkColumn.javaField}s)
  }).then(() => {
    getList()
    proxy.#[[$modal]]#.msgSuccess("删除成功")
  }).catch(() => {})
}

#if($table.sub)
/** ${subTable.functionName}添加按钮操作 */
function handleAdd${subClassName}() {
  let obj: ${subClassName} = {}
#foreach($column in $subTable.columns)
#if($column.pk || $column.javaField == ${subTableFkclassName})
#elseif($column.list && "" != $javaField)
#if($column.multiValue)
## 多选下拉/多选框的 v-model 必须是数组：给 undefined 会在 EP 内部炸（它要对值做 slice）
  obj.$column.javaField = []
#else
  obj.$column.javaField = undefined
#end
#end
#end
  ${subclassName}List.value.push(obj)
}

/** ${subTable.functionName}删除按钮操作 */
function handleDelete${subClassName}() {
  if (checked${subClassName}.value.length == 0) {
    proxy.#[[$modal]]#.msgError("请先选择要删除的${subTable.functionName}数据")
  } else {
    const ${subclassName}s = ${subclassName}List.value
    const checked${subClassName}s = checked${subClassName}.value
    ${subclassName}List.value = ${subclassName}s.filter(function(item: any) {
      return checked${subClassName}s.indexOf(item.index) == -1
    })
  }
}

/** 复选框选中数据 */
function handle${subClassName}SelectionChange(selection: any[]) {
  checked${subClassName}.value = selection.map(item => item.index)
}

#end
#if($genView)
/** 详情按钮操作 */
function handleViewData(row: ${ClassName}) {
  proxy.#[[$]]#refs["${businessName}ViewRef"].open(row.${pkColumn.javaField})
}

#end
/** 导出按钮操作 */
function handleExport() {
  proxy.download('${moduleName}/${businessName}/export', {
    ...queryParams.value
  }, `${businessName}_#[[${new Date().getTime()}]]#.xlsx`)
}

getList()
</script>

<style scoped lang="scss">
/* 长文本单元格：最多两行，超出用省略号。完整内容由 el-tooltip 展示。
   注意 tooltip 的 popper 是 teleport 到 body 的，scoped 样式够不到它，
   所以那段宽度/换行控制写在列定义的**内联 style** 上。 */
.cell-clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 富文本查看弹窗。v-html 的内容不会被 scoped 加属性，内部元素要用 :deep() */
.rich-text-body {
  max-height: 60vh;
  overflow: auto;
  line-height: 1.7;

  :deep(img) {
    max-width: 100%;
  }
}
</style>
