<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${packageName}.mapper.${ClassName}Mapper">
    
    <resultMap type="${ClassName}" id="${ClassName}Result">
#foreach ($column in $columns)
        <result property="${column.javaField}"    column="${column.columnName}"    />
#end
    </resultMap>
#if($table.sub)

    <resultMap id="${ClassName}${subClassName}Result" type="${ClassName}" extends="${ClassName}Result">
        <collection property="${subclassName}List" ofType="${subClassName}" column="${pkColumn.columnName}" select="select${subClassName}List" />
    </resultMap>

    <resultMap type="${subClassName}" id="${subClassName}Result">
#foreach ($column in $subTable.columns)
        <result property="${column.javaField}"    column="${column.columnName}"    />
#end
    </resultMap>
#end

    <sql id="select${ClassName}Vo">
        select#foreach($column in $columns) $column.columnName#if($foreach.count != $columns.size()),#end#end from ${tableName}
    </sql>

    <select id="select${ClassName}List" parameterType="${ClassName}" resultMap="${ClassName}Result">
        <include refid="select${ClassName}Vo"/>
        <where>  
#foreach($column in $columns)
#set($queryType=$column.queryType)
#set($javaField=$column.javaField)
#set($javaType=$column.javaType)
#set($columnName=$column.columnName)
#set($AttrName=$column.javaField.substring(0,1).toUpperCase() + ${column.javaField.substring(1)})
#if($column.query)
#if($column.queryType == "EQ")
## 多值列的筛选语义是「**包含任一值**」：查询区出的是多选，值以重复参数（?tags=1&tags=2）发出，
## Spring 的 ArrayToStringConverter 把它合成逗号串落到这里，所以按逗号拆开、逐个 find_in_set 再用 or 连。
## （不能写成 `= #{tags}`：那要求整串相等；也不能写成单个 find_in_set(#{tags}, …)：那会拿 '1,2' 整串去比。）
## 这一条同时修好了一个老问题：checkbox 在查询区原本退化成文本框且用 `=`，等于不可用。
#if($column.multiValue)
            <if test="$javaField != null#if($javaType == 'String') and $javaField.trim() != ''#end">
                and (
                <foreach collection="${javaField}.split(',')" item="multiValueItem" separator=" or ">
                    find_in_set(#{multiValueItem}, $columnName)
                </foreach>
                )
            </if>
#else
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName = #{$javaField}</if>
#end
#elseif($queryType == "NE")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName != #{$javaField}</if>
#elseif($queryType == "GT")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName &gt; #{$javaField}</if>
#elseif($queryType == "GTE")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName &gt;= #{$javaField}</if>
#elseif($queryType == "LT")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName &lt; #{$javaField}</if>
#elseif($queryType == "LTE")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName &lt;= #{$javaField}</if>
#elseif($queryType == "LIKE")
            <if test="$javaField != null #if($javaType == 'String' ) and $javaField.trim() != ''#end"> and $columnName like concat('%', #{$javaField}, '%')</if>
#elseif($queryType == "BETWEEN")
## ⚠️ datetime 的区间必须**半开**（`>= 开始` and `< 结束日+1天`）：
## 日期区间控件的结束值只到「日」，写成 between 就等于 `<= 结束日 00:00:00` ——
## **结束日一整天都会被排除**（实测：查 08-01~08-02 拿不到 08-02 10:30 的记录）。
## date / time / month / year 的粒度本身就是区间端点，没有这个问题，仍是闭区间。
#if($column.htmlType == "datetime")
            <if test="params.begin$AttrName != null and params.begin$AttrName != '' and params.end$AttrName != null and params.end$AttrName != ''"> and $columnName &gt;= #{params.begin$AttrName} and $columnName &lt; date_add(#{params.end$AttrName}, interval 1 day)</if>
#else
            <if test="params.begin$AttrName != null and params.begin$AttrName != '' and params.end$AttrName != null and params.end$AttrName != ''"> and $columnName between #{params.begin$AttrName} and #{params.end$AttrName}</if>
#end
#end
#end
#end
#if($softDelete)
## 逻辑删除：软删的行不该出现在列表、导出里
            and del_flag = '0'
#end
        </where>
    </select>
    
    <select id="select${ClassName}By${pkColumn.capJavaField}" parameterType="${pkColumn.javaType}" resultMap="#if($table.sub)${ClassName}${subClassName}Result#else${ClassName}Result#end">
#if($table.crud || $table.tree)
        <include refid="select${ClassName}Vo"/>
        where ${pkColumn.columnName} = #{${pkColumn.javaField}}#if($softDelete) and del_flag = '0'#end
#elseif($table.sub)
        select#foreach($column in $columns) $column.columnName#if($foreach.count != $columns.size()),#end#end
        from ${tableName}
        where ${pkColumn.columnName} = #{${pkColumn.javaField}}#if($softDelete) and del_flag = '0'#end
#end
    </select>
#if($table.sub)

    <select id="select${subClassName}List" resultMap="${subClassName}Result">
        select#foreach ($column in $subTable.columns) $column.columnName#if($foreach.count != $subTable.columns.size()),#end#end
        from ${subTableName}
        where ${subTableFkName} = #{${subTableFkName}}
    </select>
#end

    <insert id="insert${ClassName}" parameterType="${ClassName}"#if($pkColumn.increment) useGeneratedKeys="true" keyProperty="$pkColumn.javaField"#end>
        insert into ${tableName}
        <trim prefix="(" suffix=")" suffixOverrides=",">
#foreach($column in $columns)
#if($column.columnName != $pkColumn.columnName || !$pkColumn.increment)
#if($refDisplayTargets.containsKey($column.javaField) || $column.junction || ($softDelete && $column.columnName == "del_flag"))
## 这一列是别人的「冗余显示列」—— 值由关联字段的子查询（或辅助表的 refresh）写，
## 这里跳过：INSERT 会把同一列写两次、UPDATE 会把刚算好的盖掉
#else
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">$column.columnName,</if>
#if($column.refDisplaySql && $refDisplayTargets.containsKey($column.ruleDisplayColumn))
## 关联字段顺带把它的显示列一起写上（列名在这儿，值在下面的 values 里算）
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">$refDisplayTargets.get($column.ruleDisplayColumn).columnName,</if>
#end
#end
#end
#end
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
#foreach($column in $columns)
#if($column.columnName != $pkColumn.columnName || !$pkColumn.increment)
#if($refDisplayTargets.containsKey($column.javaField) || $column.junction || ($softDelete && $column.columnName == "del_flag"))
#else
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">#{$column.javaField},</if>
#if($column.refDisplaySql && $refDisplayTargets.containsKey($column.ruleDisplayColumn))
## 显示列的值由**子查询**算：表名与列名都是生成期写死的，没有动态表名的注入面。
## 单值取一行，多值（库里是逗号串）用 group_concat + find_in_set。
#if($column.multiValue)
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">(select group_concat($column.ruleRefLabelColumn) from $column.ruleRefTable where find_in_set($column.ruleRefValueColumn, #{$column.javaField})),</if>
#else
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">(select $column.ruleRefLabelColumn from $column.ruleRefTable where $column.ruleRefValueColumn = #{$column.javaField}),</if>
#end
#end
#end
#end
#end
         </trim>
    </insert>

    <update id="update${ClassName}" parameterType="${ClassName}">
        update ${tableName}
        <trim prefix="SET" suffixOverrides=",">
#foreach($column in $columns)
#if($column.columnName != $pkColumn.columnName)
#if($refDisplayTargets.containsKey($column.javaField) || $column.junction || ($softDelete && $column.columnName == "del_flag"))
## 冗余显示列：值由关联字段那一支的子查询写，这里跳过（否则后写的会把子查询的结果盖掉）
#else
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">$column.columnName = #{$column.javaField},</if>
#if($column.refDisplaySql && $refDisplayTargets.containsKey($column.ruleDisplayColumn))
## 改了关联就得跟着重算名称 —— 同一条语句内完成，没有「先存 id 再补名称」的中间态
#if($column.multiValue)
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">$refDisplayTargets.get($column.ruleDisplayColumn).columnName = (select group_concat($column.ruleRefLabelColumn) from $column.ruleRefTable where find_in_set($column.ruleRefValueColumn, #{$column.javaField})),</if>
#else
            <if test="$column.javaField != null#if($column.javaType == 'String' && $column.required) and $column.javaField != ''#end">$refDisplayTargets.get($column.ruleDisplayColumn).columnName = (select $column.ruleRefLabelColumn from $column.ruleRefTable where $column.ruleRefValueColumn = #{$column.javaField}),</if>
#end
#end
#end
#end
#end
        </trim>
        where ${pkColumn.columnName} = #{${pkColumn.javaField}}
    </update>

    <delete id="delete${ClassName}By${pkColumn.capJavaField}" parameterType="${pkColumn.javaType}">
#if($softDelete)
## 逻辑删除：翻标志而不是物理删（值取 RuoYi 惯例：'0' 存在、'2' 删除）
        update ${tableName} set del_flag = '2' where ${pkColumn.columnName} = #{${pkColumn.javaField}}
#else
        delete from ${tableName} where ${pkColumn.columnName} = #{${pkColumn.javaField}}
#end
    </delete>

    <delete id="delete${ClassName}By${pkColumn.capJavaField}s" parameterType="String">
#if($softDelete)
        update ${tableName} set del_flag = '2' where ${pkColumn.columnName} in
#else
        delete from ${tableName} where ${pkColumn.columnName} in
#end
        <foreach item="${pkColumn.javaField}" collection="array" open="(" separator="," close=")">
            #{${pkColumn.javaField}}
        </foreach>
    </delete>
#if($table.sub)
    
    <delete id="delete${subClassName}By${subTableFkClassName}s" parameterType="String">
        delete from ${subTableName} where ${subTableFkName} in 
        <foreach item="${subTableFkclassName}" collection="array" open="(" separator="," close=")">
            #{${subTableFkclassName}}
        </foreach>
    </delete>

    <delete id="delete${subClassName}By${subTableFkClassName}" parameterType="${pkColumn.javaType}">
        delete from ${subTableName} where ${subTableFkName} = #{${subTableFkclassName}}
    </delete>

    <insert id="batch${subClassName}">
        insert into ${subTableName}(#foreach($column in $subTable.columns) $column.columnName#if($foreach.count != $subTable.columns.size()),#end#end) values
        <foreach item="item" index="index" collection="list" separator=",">
            (#foreach($column in $subTable.columns) #{item.$column.javaField}#if($foreach.count != $subTable.columns.size()),#end#end)
        </foreach>
    </insert>
#end
#foreach($column in $columns)
#if($column.junction)
## ── 辅助表维护的多对多 ──
## 关联关系不在本表，全在这张中间表里：读详情时查出来回填实体、保存时先删后插。
## 辅助表名与外键都是生成期写死的，没有动态表名的注入面。

    <select id="select${column.idsFieldCap}By${pkColumn.capJavaField}" resultType="java.lang.Long">
        select ${column.ruleJunctionRefFk} from ${column.ruleJunctionTable} where ${column.ruleJunctionMainFk} = #{${pkColumn.javaField}}
    </select>

    <insert id="batch${column.idsFieldCap}">
        insert into ${column.ruleJunctionTable}(${column.ruleJunctionMainFk}, ${column.ruleJunctionRefFk}) values
        <foreach collection="refIds" item="refId" separator=",">
            (#{${pkColumn.javaField}}, #{refId})
        </foreach>
    </insert>

    <delete id="delete${column.idsFieldCap}By${pkColumn.capJavaField}">
        delete from ${column.ruleJunctionTable} where ${column.ruleJunctionMainFk} = #{${pkColumn.javaField}}
    </delete>

    <delete id="delete${column.idsFieldCap}By${pkColumn.capJavaField}s">
        delete from ${column.ruleJunctionTable} where ${column.ruleJunctionMainFk} in
        <foreach collection="${pkColumn.javaField}s" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </delete>
#if("" != $column.ruleRefTable && "" != $column.ruleRefValueColumn && "" != $column.ruleRefLabelColumn)
## 冗余显示列（就是配置挂的这一列）按辅助表重算：先删后插完再算，顺序不能反
    <update id="refresh${column.idsFieldCap}Names">
        update ${tableName} set $column.columnName = (
            select group_concat(t.${column.ruleRefLabelColumn}) from ${column.ruleJunctionTable} j
            join ${column.ruleRefTable} t on t.${column.ruleRefValueColumn} = j.${column.ruleJunctionRefFk}
            where j.${column.ruleJunctionMainFk} = #{${pkColumn.javaField}}
        ) where ${pkColumn.columnName} = #{${pkColumn.javaField}}
    </update>
#end
#end
#end
</mapper>